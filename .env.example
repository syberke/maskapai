# ==========================================
# POSTGRESQL DOCKER COMPOSE
# ==========================================
# Tidak perlu install PostgreSQL di Ubuntu host.
# Compose membuat user, password, dan database ini saat volume masih kosong.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=maskapai

# Di dalam Docker Compose hostname database adalah `database`, BUKAN localhost.
DATABASE_URL="postgresql://postgres:postgres@database:5432/maskapai?schema=public"

# ==========================================
# NEXT.JS PUBLIC ENV
# ==========================================
# NEXT_PUBLIC_* dibaca ketika `docker compose build`.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=replace-with-recaptcha-site-key
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=replace-with-midtrans-client-key
NEXT_PUBLIC_APP_URL=http://YOUR_VM_IP:8080

# ==========================================
# SERVER-ONLY SECRETS
# ==========================================
RECAPTCHA_SECRET_KEY=replace-with-recaptcha-secret-key
JWT_SECRET=replace-with-a-long-random-secret
MIDTRANS_SERVER_KEY=replace-with-midtrans-server-key

# ==========================================
# SMTP
# ==========================================
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=replace-with-mail-user
MAIL_PASS=replace-with-mail-password
MAIL_FROM="Renggo Maskapai <no-reply@renggo.id>"
