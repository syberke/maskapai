# PostgreSQL used by Docker Compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=maskapai

# Local Prisma CLI URL. Docker Compose overrides DATABASE_URL inside containers
# so the application connects to the `postgres` service over the Docker network.
DATABASE_URL="postgresql://postgres:change-this-password@localhost:5432/maskapai?schema=public"

# Public browser environment. NEXT_PUBLIC_* values are baked during docker compose build.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=replace-with-recaptcha-site-key
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=replace-with-midtrans-client-key
NEXT_PUBLIC_APP_URL=http://YOUR_VM_IP_OR_DOMAIN

# Server-only secrets
RECAPTCHA_SECRET_KEY=replace-with-recaptcha-secret-key
JWT_SECRET=replace-with-a-long-random-secret
MIDTRANS_SERVER_KEY=replace-with-midtrans-server-key

# SMTP
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=replace-with-mail-user
MAIL_PASS=replace-with-mail-password
MAIL_FROM="Renggo Maskapai <no-reply@renggo.id>"
